# GraphRail server/worker. No LLM key: the connected MCP agent interprets intent.
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Supabase Connect > Session pooler (5432), or direct. URL-encode the password.
# postgres://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=
DATABASE_SSL=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PACKAGE_BUCKET=graphrail-packages
# The same Supabase host/database as DATABASE_URL. No sink password here:
# enter it in The Graph Market secret page for each prepared deployment slot.
SINK_DB_HOST=
SINK_DB_PORT=5432
SINK_DB_USER=
SINK_DB_NAME=postgres
SINK_NETWORK=mainnet
GRAPH_MARKET_BASE_URL=https://admin.streamingfast.io
# Market login tokens are stored in the private graphrail schema by setup:market.
HEDERA_NETWORK=hedera:testnet
HEDERA_PAY_TO=
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_HCS_TOPIC_ID=
BLOCKY_FACILITATOR_URL=https://api.testnet.blocky402.com
BLOCKY_API_KEY=
PAYMENT_ASSET=0.0.0
# HBAR prices in tinybar: 100,000,000 = 1 HBAR. These are not USD.
COMMISSION_AMOUNT=100000000
QUERY_AMOUNT=100000
SUBSTREAMS_API_KEY=
SUBSTREAMS_BIN=substreams
BUILD_ROOT=./builds
COMMISSIONING_ENABLED=false
BUILD_TIMEOUT_MS=900000
OUTPUT_TEST_BLOCKS=100
WORKER_POLL_MS=3000
# Optional payment-capable demo CLIENT; its wallet never belongs in MCP requests.
BUYER_ACCOUNT_ID=
BUYER_PRIVATE_KEY=
BUYER_MAX_PAYMENT=100100000
